<?xml version="1.0" encoding="utf-8"?>
<!-- 2.36 Pro template "neon": violet-deep gradient, neon violet stroke. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="45"
        android:startColor="#1A1A2E"
        android:centerColor="#2D1B4E"
        android:endColor="#4A148C"
        android:type="linear" />
    <corners android:radius="28dp" />
    <stroke android:width="2dp" android:color="#B388FF" />
</shape>
