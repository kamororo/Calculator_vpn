<?xml version="1.0" encoding="utf-8"?>
<!-- 2.36 Pro template "glass": dark glass, diagonal sheen, steel stroke. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="135"
        android:startColor="#263238"
        android:centerColor="#1E2A33"
        android:endColor="#37474F"
        android:type="linear" />
    <corners android:radius="28dp" />
    <stroke android:width="1.5dp" android:color="#546E7A" />
</shape>
