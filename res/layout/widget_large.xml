<?xml version="1.0" encoding="utf-8"?>
<!-- 2.17 2x2 widget: glass orb + section name + status dot + status + restart pill.
     RemoteViews-supported views only. Ids: widget_btn, widget_icon, widget_name, widget_dot, widget_status, widget_restart. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/widget_root"
    android:background="@drawable/widget_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="10dp">

    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp">

        <TextView
            android:id="@+id/widget_btn"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/widget_circle_off"
            android:gravity="center"
            android:text="V"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/widget_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/widget_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="v2ray"
        android:textColor="#333333"
        android:textSize="15sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/widget_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/widget_dot_off" />

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="Disconnected"
            android:textColor="#666666"
            android:textSize="12sp" />
    </LinearLayout>

    <Button
        android:id="@+id/widget_restart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_restart_pill"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:text="↻"
        android:textColor="#0D47A1"
        android:textSize="16sp" />
</LinearLayout>
